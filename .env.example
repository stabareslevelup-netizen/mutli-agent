# Copy to .env and fill in. The engine never hardcodes keys; it resolves them
# from here per the brand config's `credentials_ref: env`.

# Which brand config the engine runs (the ONLY brand-specific pointer).
BRAND_CONFIG_PATH=brands/madre_de_maquinas.yaml

# Postgres + pgvector. If unset, the API boots without DB (Phase 1 dev).
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/media_engine
EMBED_DIM=1024

# Anthropic (Claude Agent SDK + server-side web_search tool) — Phase 4.
# ANTHROPIC_API_KEY=

# Distribution — human confirm still gates every post (posting_mode: confirm).
# X: needs OAuth 1.0a USER CONTEXT (an app-only bearer token is read-only for
# posting). Generate all four from the X Developer Portal, per-app, once —
# no interactive auth flow needed at request time. Leave any unset and the
# app degrades gracefully: Approve still works, it just stages instead of
# publishing ("approved; publish pending live platform credentials").
# X_API_KEY=
# X_API_KEY_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# INSTAGRAM_GRAPH_TOKEN=
# YOUTUBE_API_KEY=

# Notify (optional): push a Slack message whenever a job reaches the review
# queue, so you don't have to poll the dashboard to know something's waiting.
# Slack -> your workspace -> Apps -> Incoming Webhooks -> copy the URL.
# SLACK_WEBHOOK_URL=
# REVIEW_DASHBOARD_URL=http://localhost:8000

PORT=8000
